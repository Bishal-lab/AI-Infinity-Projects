# Copy to .env and fill in. .env is git-ignored; never commit real values.
# On GitHub Actions these go in Settings → Secrets and variables → Actions
# instead, with the same names.

# ------------------------------------------------------------------- Gmail
# The radar mails the digest over SMTP. Gmail refuses ordinary passwords, so
# this must be an App Password:
#   myaccount.google.com → Security → 2-Step Verification (turn on)
#                        → App passwords → generate one for "Mail"
# It is 16 characters; spaces in it are ignored, keep or drop them.
#
# The BFSI digest bot in this repo already uses these two secret names. If you
# set them up for that bot, the radar needs nothing further.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# Where the digest goes. Defaults to GMAIL_ADDRESS. Comma-separated for several.
EMAIL_TO=das.bishal178@gmail.com

# Optional: the display name on the From: header.
EMAIL_FROM_NAME=VP Role Radar

# --------------------------------------------------------- optional sources
# Everything below is optional. Each keyed source stays switched off and says
# so in `check-sources` until its key is present — nothing breaks without them.
#
# Careerjet: free affiliate id from https://www.careerjet.com/partners/
# Widest reach of the three across India AND the Gulf, so start here.
CAREERJET_AFFID=

# Jooble: free API key from https://jooble.org/api/about
JOOBLE_API_KEY=

# Adzuna: free app id + key from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
