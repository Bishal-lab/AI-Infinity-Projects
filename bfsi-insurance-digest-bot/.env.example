# Copy to .env and fill in. .env is git-ignored; never commit real values.
# On GitHub Actions these go in Settings → Secrets and variables → Actions
# instead, with the same names.

# ---------------------------------------------------------------- Telegram
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
# 2. It replies with a token that looks like 123456789:AAE...  — paste it here.
TELEGRAM_BOT_TOKEN=

# 3. Send your new bot any message (it cannot write to you until you do).
# 4. Open https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and copy
#    result[0].message.chat.id — a number, negative for groups.
#    Several chats: separate with commas.
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------- Gmail
# Gmail refuses ordinary passwords over SMTP. You need an App Password:
#   myaccount.google.com → Security → 2-Step Verification (turn on)
#                        → App passwords → generate one for "Mail"
# It is 16 characters; spaces in it are ignored, keep or drop them.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# Where the brief goes. Defaults to GMAIL_ADDRESS. Comma-separated for several.
EMAIL_TO=you@gmail.com

# Optional: the display name on the From: header.
EMAIL_FROM_NAME=BFSI Digest Bot
