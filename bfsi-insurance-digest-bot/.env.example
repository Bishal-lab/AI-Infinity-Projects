# Copy to .env and fill in. .env is git-ignored; never commit real values.
# On GitHub Actions these go in Settings → Secrets and variables → Actions
# instead, with the same names.

# ---------------------------------------------------------------- Telegram
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
# 2. It replies with a token that looks like 123456789:AAE...  — paste it here.
TELEGRAM_BOT_TOKEN=

# 3. Send your new bot any message (it cannot write to you until you do).
# 4. Run `python -m bot telegram-chats` — with the token above set, it prints
#    the chat ids the bot can see, with names attached. Negative for groups.
#    Several chats: separate with commas.
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------- Gmail
# NOT your Google account password. Gmail's SMTP refuses those, always, and
# your account password unlocks far more than mail — it does not belong in
# this file, in a repository secret, or in a chat window.
#
# What goes below is an App Password, which Google GENERATES for you:
#   myaccount.google.com → Security → 2-Step Verification (turn on first;
#                          App passwords do not exist without it)
#                        → App passwords → generate one for "Mail"
#
# It is exactly 16 lowercase letters, shown as four groups of four:
#   abcd efgh ijkl mnop
# Spaces are stripped, so keep or drop them. Anything of a different length,
# or containing a capital or a digit, is not an App Password — `python -m bot
# test-delivery` will say so rather than letting the 08:00 run find out.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# Where the brief goes. Defaults to GMAIL_ADDRESS. Comma-separated for several.
EMAIL_TO=you@gmail.com

# Optional: the display name on the From: header.
EMAIL_FROM_NAME=BFSI Digest Bot
